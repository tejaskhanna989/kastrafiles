[Desktop Entry]
Name=Kastrafiles
GenericName=File Manager
Comment=A lightweight Qt6/QML file manager for Wayland
Exec=kastrafiles %F
Icon=io.github.tejaskhanna989.Kastrafiles
Terminal=false
Type=Application
Categories=System;FileManager;Qt;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=kastrafiles
Keywords=files;explorer;manager;browser;filesystem;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=kastrafiles --new-window
